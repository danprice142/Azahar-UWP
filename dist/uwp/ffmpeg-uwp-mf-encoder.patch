+static int mf_setup_uwp_device(AVCodecContext *avctx)
+{
+#if HAVE_UWP
+    MFContext *c = avctx->priv_data;
+    IMFAttributes *attrs = NULL;
+    UINT32 aware = 0;
+    UINT token;
+    HRESULT hr;
+
+    if (!c->is_video || !c->opt_enc_hw)
+        return 0;
+
+    hr = IMFTransform_GetAttributes(c->mft, &attrs);
+    if (FAILED(hr))
+        return AVERROR_EXTERNAL;
+    hr = IMFAttributes_GetUINT32(attrs, &ff_MF_SA_D3D11_AWARE, &aware);
     IMFAttributes_Release(attrs);
-    return res;
+    if (FAILED(hr) || !aware)
+        return 0;
+
+    hr = D3D11CreateDevice(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL,
+                          D3D11_CREATE_DEVICE_BGRA_SUPPORT | D3D11_CREATE_DEVICE_VIDEO_SUPPORT,
+                          NULL, 0, D3D11_SDK_VERSION, &c->d3d11_device, NULL, NULL);
+    if (SUCCEEDED(hr))
+        hr = MFCreateDXGIDeviceManager(&token, &c->dxgi_manager);
+    if (SUCCEEDED(hr))
+        hr = IMFDXGIDeviceManager_ResetDevice(c->dxgi_manager,
+                                             (IUnknown *)c->d3d11_device, token);
+    if (SUCCEEDED(hr))
+        hr = IMFTransform_ProcessMessage(c->mft, MFT_MESSAGE_SET_D3D_MANAGER,
+                                         (ULONG_PTR)c->dxgi_manager);
+    av_log(avctx, FAILED(hr) ? AV_LOG_ERROR : AV_LOG_INFO,
+           "UWP hardware encoder D3D11 manager: %s\n", ff_hr_str(hr));
+    if (FAILED(hr))
+        return AVERROR_EXTERNAL;
+#endif
+    return 0;
 }
 
