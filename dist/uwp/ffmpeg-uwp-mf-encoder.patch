+static int mf_poll_events(AVCodecContext *avctx)
+{
+    MFContext *c = avctx->priv_data;
+    int count;
+
+    /* A shared live audio/video worker must never wait for a hardware event.
+     * Each event grants one input/output operation; preserve multiple grants.
+     * Bound unrelated events too, so a noisy transform cannot monopolize it. */
+    for (count = 0; count < 64; ++count) {
+        IMFMediaEvent *ev = NULL;
+        MediaEventType ev_id = 0;
+        HRESULT event_status = S_OK;
+        HRESULT hr = IMFMediaEventGenerator_GetEvent(c->async_events,
+                                                    MF_EVENT_FLAG_NO_WAIT, &ev);
+        if (hr == MF_E_NO_EVENTS_AVAILABLE)
+            return 0;
+        if (FAILED(hr)) {
+            av_log(avctx, AV_LOG_ERROR, "Polling hardware encoder event failed: %s\n",
+                   ff_hr_str(hr));
+            return AVERROR_EXTERNAL;
+        }
+        hr = IMFMediaEvent_GetStatus(ev, &event_status);
+        if (SUCCEEDED(hr))
+            hr = IMFMediaEvent_GetType(ev, &ev_id);
+        IMFMediaEvent_Release(ev);
+        if (FAILED(hr) || FAILED(event_status)) {
+            av_log(avctx, AV_LOG_ERROR, "Hardware encoder event failed: %s\n",
+                   ff_hr_str(FAILED(hr) ? hr : event_status));
+            return AVERROR_EXTERNAL;
+        }
+        switch (ev_id) {
+        case ff_METransformNeedInput:
+            if (!c->draining)
+                c->async_need_input++;
+            break;
+        case ff_METransformHaveOutput:
+            c->async_have_output++;
+            break;
+        case ff_METransformDrainComplete:
+            c->draining_done = 1;
+            break;
+        default: ;
+        }
+    }
+    return 0;
+}
