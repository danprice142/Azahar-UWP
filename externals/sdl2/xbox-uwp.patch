+#if defined(__WINRT__) && defined(SDL_JOYSTICK_XINPUT)
+    /* WinRT builds have neither the device-notification window nor the joystick thread, so
+       nothing ever sets s_bWindowsDeviceChanged after the initial scan. On Xbox the pad only
+       becomes visible to XInput a moment after launch, once the system's GameInput bridge has
+       announced it, so the init-time scan always misses it. Poll the slots for changes here. */
+    if (SDL_XINPUT_Enabled()) {
+        static Uint32 s_lastSlotScan;
+        static SDL_bool s_slotPresent[XUSER_MAX_COUNT];
+        const Uint32 now = SDL_GetTicks();
+        if (!s_lastSlotScan || SDL_TICKS_PASSED(now, s_lastSlotScan + 1000)) {
+            Uint8 userId;
+            for (userId = 0; userId < XUSER_MAX_COUNT; userId++) {
+                XINPUT_CAPABILITIES capabilities;
