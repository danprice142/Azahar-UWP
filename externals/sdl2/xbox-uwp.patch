@@ -589,6 +600,59 @@ void SDL_WinRTApp::OnWindowClosed(CoreWindow ^ sender, CoreWindowEventArgs ^ arg
 
 void SDL_WinRTApp::OnAppActivated(CoreApplicationView ^ applicationView, IActivatedEventArgs ^ args)
 {
+    auto deliverActivationPath = [this](Platform::String ^ path) {
+        if (!path || path->IsEmpty()) {
+            return;
+        }
+        if (m_mainRunning) {
+            char *utf8Path = WIN_StringToUTF8W(path->Data());
+            if (utf8Path) {
+                SDL_SendDropFile(WINRT_GlobalSDLWindow, utf8Path);
+                SDL_free(utf8Path);
+            }
+        } else {
+            m_activationFilePath = path;
+        }
+    };
+
+    if (args && args->Kind == ActivationKind::File) {
+        FileActivatedEventArgs ^ fileArgs = dynamic_cast<FileActivatedEventArgs ^>(args);
+        if (fileArgs && fileArgs->Files && fileArgs->Files->Size > 0) {
+            deliverActivationPath(fileArgs->Files->GetAt(0)->Path);
+        }
+    } else if (args && args->Kind == ActivationKind::Protocol) {
+        ProtocolActivatedEventArgs ^ protocolArgs =
+            dynamic_cast<ProtocolActivatedEventArgs ^>(args);
+        if (protocolArgs && protocolArgs->Uri) {
+            Platform::String ^ commandLine = nullptr;
+            try {
+                commandLine = protocolArgs->Uri->QueryParsed->GetFirstValueByName(L"cmd");
+            } catch (Platform::Exception ^) {
+                // A bare azahar: URI is also used to probe protocol availability.
+            }
+            if (commandLine && !commandLine->IsEmpty()) {
+                const wchar_t *path = commandLine->Data();
+                while (*path != L'\0' && *path != L' ' && *path != L'\t') {
+                    ++path;
+                }
+                while (*path == L' ' || *path == L'\t') {
+                    ++path;
+                }
+                size_t pathLength = 0;
+                while (path[pathLength] != L'\0') {
+                    ++pathLength;
+                }
+                if (pathLength >= 2 && path[0] == L'\"' && path[pathLength - 1] == L'\"') {
+                    ++path;
+                    pathLength -= 2;
+                }
+                if (pathLength != 0) {
+                    deliverActivationPath(
+                        ref new Platform::String(path, static_cast<unsigned int>(pathLength)));
+                }
+            }
+        }
+    }
     CoreWindow::GetForCurrentThread()->Activate();
 }
 
