+                const SDL_bool available = (result == ERROR_SUCCESS) ? SDL_TRUE : SDL_FALSE;
+                if (s_slotPresent[userId] != available) {
+                    s_bWindowsDeviceChanged = SDL_TRUE;
+                    s_slotPresent[userId] = available;
+                }
+            }
+            s_lastSlotScan = now ? now : 1;
+        }
+    }
+#endif
